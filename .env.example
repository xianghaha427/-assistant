# 复制为 .env 后按需填写。留空的外部服务不会阻止平台启动。
MYSQL_PASSWORD=123456
MYSQL_PORT=3307
FRONTEND_PORT=8088
WHISPER_PORT=8766

DIFY_BASE_URL=https://api.dify.ai
DIFY_KB_API_KEY=
DIFY_MEETING_API_KEY=
DIFY_INSIGHT_API_KEY=
DIFY_PPT_API_KEY=
DIFY_WRITER_API_KEY=

# 工具调用编排模型（POST /api/ai/agent-exec）。三项全留空则工具编排功能关闭，平台照常启动。
# BASE_URL 与 NAME 必须同时填写才会启用；指向的端点需支持 function calling。
FINPILOT_MODEL_BASE_URL=
FINPILOT_MODEL_API_KEY=
FINPILOT_MODEL_NAME=

# 本地知识文档检索（知识问答页的「本地文档」模式）：只检索平台上上传、且当前用户有权限访问的文档。
# 与上面的工具调用模型是两条独立通道，此处留空则自动复用下面的 DEEPSEEK_API_KEY。
# 若要整体关闭本地模式：把 FINPILOT_KB_MODEL_BASE_URL 显式写成空值（保留等号、后面不填）即可。
FINPILOT_KB_MODEL_BASE_URL=https://api.deepseek.com
FINPILOT_KB_MODEL_API_KEY=
FINPILOT_KB_MODEL_NAME=deepseek-chat
FINPILOT_KB_MODEL_MAX_CONTEXT_CHARS=30000

# 本地知识检索所用的模型密钥（Dify 侧底层模型同源）
DEEPSEEK_API_KEY=

DINGTALK_ENABLED=false
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=
